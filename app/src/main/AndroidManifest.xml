<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Internet (Firebase sync, optional) ── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Camera (ML Kit food recognition) ── -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- ── Đo nhịp tim bằng camera + đèn flash (PPG): cần camera sau có đèn flash ── -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- ── Đếm bước bằng cảm biến của máy (từ Android 10 mới cần ACTIVITY_RECOGNITION) ── -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <!-- ── Tự tính giờ ngủ: cảm biến ánh sáng + gia tốc (không cần quyền nào) ── -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.light" android:required="false" />

    <!-- ── Notifications (WorkManager reminders) ── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      ── Health Connect Permissions (chỉ ĐỌC — phụ lục C #44) ──
      Trước đây manifest khai thêm WRITE_STEPS/WRITE_SLEEP nhưng **không code nào ghi dữ liệu lên
      Health Connect** (xem `HealthConnectDataSourceImpl.requiredPermissions` — chỉ có 4 quyền ĐỌC)
      ⇒ hộp thoại xin quyền hỏi thừa quyền ghi và làm người dùng/Play review nghi ngờ. Chỉ giữ đúng
      những quyền app thật sự dùng.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <!-- ── Health Connect package query (bắt buộc từ Android 11+) ── -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_HEALTH_PERMISSIONS" />
        </intent>
    </queries>

    <!--
      allowBackup=false (mục 3 #32): DB SQLCipher + prefs bị auto-backup lên Google Drive, nhưng KHOÁ
      mở DB nằm trong Android Keystore (KHÔNG backup được) ⇒ restore trên máy mới sẽ mở DB thất bại và
      rơi vào nhánh xoá DB (LegacyDatabaseKeyMigration) = mất sạch dữ liệu. Tắt hẳn backup cục bộ để
      không có bản sao rò rỉ dữ liệu sức khỏe và không có "restore" nào xoá dữ liệu của người dùng.
    -->
    <application
        android:name=".HiltApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HealthyAIApp">

        <!-- ── Main Activity ── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HealthyAIApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Rationale activity for Health Connect (Pre-Android 14) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- ── Health Connect: Privacy Policy rationale ── -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- ── WorkManager: Tắt auto-init để dùng HiltWorkerFactory ── -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- ── Home Screen Widget (Glance): "Sức khỏe hôm nay" — bước chân / giấc ngủ / nhịp tim ── -->
        <receiver
            android:name=".presentation.widget.HealthWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/health_widget_info" />
        </receiver>

    </application>
</manifest>
